];


const $ = id => document.getElementById(id);

function shuffle(a) {
  const r = a.slice();
  for (let i = r.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [r[i], r[j]] = [r[j], r[i]];
  }
  return r;
}

let queue = [];
let idx = 0;
let score = 0;
let wrong = [];
let locked = false;
let current = [];

function show(name) {
  $('quiz').hidden = name !== 'quiz';
  $('result').hidden = name !== 'result';
  window.scrollTo(0, 0);
}

function typeset() {
  if (window.MathJax && MathJax.typesetPromise) {
    MathJax.typesetPromise();
  }
}

function start(list, shuffleQuestions) {
  queue = shuffleQuestions ? shuffle(list) : list.slice();
  idx = 0;
  score = 0;
  wrong = [];
  show('quiz');
  render();
}

function render() {
  const q = queue[idx];
  locked = false;

  $('count').textContent = 'Pergunta ' + (idx + 1) + ' de ' + queue.length;
  $('score').textContent = 'Certas: ' + score;
  $('bar').style.width = (idx / queue.length * 100) + '%';
  $('prompt').innerHTML = q.p;

  current = shuffle(q.o.map((t, k) => ({ t, ok: k === 0 })));

  const box = $('options');
  box.textContent = '';

  current.forEach((o, k) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'opt';

    const L = document.createElement('span');
    L.className = 'letter';
    L.textContent = 'ABCD'[k];

    const T = document.createElement('span');
    T.className = 'otext';
    T.innerHTML = o.t;

    const M = document.createElement('span');
    M.className = 'mark';
    M.setAttribute('aria-hidden', 'true');

    b.append(L, T, M);
    b.addEventListener('click', () => answer(k));
    box.appendChild(b);
  });

  $('feedback').hidden = true;
  typeset();
}

function answer(k) {
  if (locked) return;
  locked = true;

  const q = queue[idx];
  const box = $('options');
  const chosen = current[k];

  current.forEach((o, n) => {
    const btn = box.children[n];
    btn.disabled = true;

    if (o.ok) {
      btn.classList.add('ok');
      btn.querySelector('.mark').textContent = '✓';
    } else if (n === k) {
      btn.classList.add('bad');
      btn.querySelector('.mark').textContent = '✗';
    }
  });

  if (chosen.ok) {
    score++;
  } else {
    wrong.push({ q, chosen: chosen.t });
  }

  $('score').textContent = 'Certas: ' + score;
  $('verdict').textContent = chosen.ok ? 'Certo.' : 'Não é essa.';
  $('explain').innerHTML = q.e;
  $('next').textContent = idx === queue.length - 1 ? 'Ver resultado' : 'Seguinte';
  $('feedback').hidden = false;
  $('bar').style.width = ((idx + 1) / queue.length * 100) + '%';

  typeset();
  $('next').focus();
}

function next() {
  idx++;
  if (idx >= queue.length) finish();
  else render();
}

function finish() {
  show('result');

  const total = queue.length;
  $('final').textContent = score + ' de ' + total;

  const pct = score / total;
  $('finalMsg').textContent = wrong.length === 0
    ? 'Tudo certo.'
    : pct >= 0.75
      ? 'Bom resultado. Revê as perguntas que falhaste.'
      : 'Vale a pena rever os apontamentos e refazer as perguntas que falhaste.';

  $('retryWrong').hidden = wrong.length === 0;

  const rev = $('review');
  rev.textContent = '';

  if (wrong.length) {
    const h = document.createElement('h3');
    h.textContent = 'Perguntas falhadas';
    rev.appendChild(h);

    wrong.forEach(w => {
      const d = document.createElement('div');
      d.className = 'rev-item';

      const p = document.createElement('p');
      p.innerHTML = w.q.p;
      p.style.fontWeight = '600';

      const y = document.createElement('p');
      y.className = 'you';
      y.innerHTML = '✗ A tua resposta: ' + w.chosen;

      const r = document.createElement('p');
      r.className = 'right';
      r.innerHTML = '✓ Resposta certa: ' + w.q.o[0];

      d.append(p, y, r);
      rev.appendChild(d);
    });

    typeset();
  }
}

$('next').addEventListener('click', next);
$('restart').addEventListener('click', () => start(Q, true));
$('retryWrong').addEventListener('click', () => start(wrong.map(w => w.q), false));

document.addEventListener('keydown', e => {
  if ($('quiz').hidden || locked) return;
  const k = ['1', '2', '3', '4'].indexOf(e.key);
  if (k >= 0 && k < current.length) answer(k);
});

start(Q, false);

</script>
