<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Matrizes e Determinantes: verificação de leitura</title>

<style>
:root {
  --bg: #f7f7f5;
  --surface: #ffffff;
  --text: #1c1f24;
  --muted: #5d6570;
  --border: #d3d7db;
  --accent: #2848b8;
  --accent-text: #ffffff;
  --ok-bg: #e3f4e8;
  --ok-border: #2f8a4f;
  --bad-bg: #fbe7e6;
  --bad-border: #c23b36;
  box-sizing: border-box;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #15171a;
    --surface: #1e2125;
    --text: #eceef0;
    --muted: #a0a8b2;
    --border: #3a3f46;
    --accent: #7c9bff;
    --accent-text: #0e1320;
    --ok-bg: #17301f;
    --ok-border: #4fb26f;
    --bad-bg: #3a1c1b;
    --bad-border: #e0645f;
  }
}

:root[data-theme="dark"] {
  --bg: #15171a;
  --surface: #1e2125;
  --text: #eceef0;
  --muted: #a0a8b2;
  --border: #3a3f46;
  --accent: #7c9bff;
  --accent-text: #0e1320;
  --ok-bg: #17301f;
  --ok-border: #4fb26f;
  --bad-bg: #3a1c1b;
  --bad-border: #e0645f;
}

*, *::before, *::after { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  font-size: 17px;
  line-height: 1.5;
}

main {
  max-width: 640px;
  margin: 0 auto;
  padding: 20px 16px 40px;
}

h1 {
  font-size: 1.35rem;
  line-height: 1.25;
  margin: 0 0 4px;
}

.sub {
  color: var(--muted);
  font-size: 0.9rem;
  margin: 0 0 8px;
}

.disclaimer {
  color: var(--muted);
  font-size: 0.78rem;
  line-height: 1.4;
  margin: 0 0 20px;
}

.meta {
  display: flex;
  justify-content: space-between;
  font-size: 0.9rem;
  color: var(--muted);
  margin-bottom: 6px;
}

.track {
  height: 6px;
  background: var(--border);
  border-radius: 3px;
  overflow: hidden;
  margin-bottom: 20px;
}

.fill {
  height: 100%;
  width: 0;
  background: var(--accent);
  transition: width 0.25s ease;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px 18px;
}

#prompt {
  font-size: 1.15rem;
  font-weight: 600;
  line-height: 1.4;
  margin: 0 0 16px;
}

#options {
  display: grid;
  gap: 10px;
}

.opt {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
  text-align: left;
  font: inherit;
  color: var(--text);
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: 10px;
  padding: 12px 14px;
  cursor: pointer;
}

.opt:hover:not(:disabled) { border-color: var(--accent); }

.opt:disabled {
  cursor: default;
  color: var(--text);
  opacity: 1;
}

.opt:focus-visible, .btn:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 2px;
}

.letter {
  flex: none;
  width: 1.7em;
  height: 1.7em;
  border-radius: 50%;
  border: 1.5px solid var(--border);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--muted);
}

.otext {
  flex: 1;
  overflow-wrap: anywhere;
}

.mark { flex: none; font-weight: 700; }

.opt.ok { background: var(--ok-bg); border-color: var(--ok-border); }
.opt.bad { background: var(--bad-bg); border-color: var(--bad-border); }
.opt.ok .mark { color: var(--ok-border); }
.opt.bad .mark { color: var(--bad-border); }

#feedback {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--border);
}

#verdict { font-weight: 700; margin: 0 0 4px; }
#explain { margin: 0 0 16px; color: var(--text); }

.btn {
  font: inherit;
  font-weight: 600;
  background: var(--accent);
  color: var(--accent-text);
  border: 0;
  border-radius: 10px;
  padding: 11px 20px;
  cursor: pointer;
}

.btn.secondary {
  background: transparent;
  color: var(--text);
  border: 1.5px solid var(--border);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 20px;
}

#result h2 { margin: 0 0 4px; font-size: 1.4rem; }
.big { font-size: 2.2rem; font-weight: 700; margin: 0 0 4px; }
.review { margin-top: 20px; display: grid; gap: 12px; }
.review h3 { font-size: 1rem; margin: 0; }

.rev-item {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 14px;
  background: var(--surface);
}

.rev-item p { margin: 0 0 6px; }
.rev-item .you { color: var(--bad-border); }
.rev-item .right { color: var(--ok-border); margin-bottom: 0; }

[hidden] { display: none !important; }

@media (prefers-reduced-motion: reduce) {
  .fill { transition: none; }
}
</style>

<script>
window.MathJax = {
  tex: {
    inlineMath: [['\\(', '\\)']],
    displayMath: [['\\[', '\\]']]
  },
  svg: { fontCache: 'global' }
};
